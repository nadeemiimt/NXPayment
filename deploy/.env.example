# Per-merchant install secrets — never share across tenants
PRIMARY_VPA=merchant@upi
SECONDARY_VPA=
MERCHANT_DISPLAY_NAME="Demo Merchant"
BRAND_NAME=NXPayment
ACCENT_COLOR="#0B6E4F"
LOGO_URL=
ADMIN_TOKEN=change-me-admin-token
WEBHOOK_SECRET=change-me-webhook-secret
WEBHOOK_URL=
PAYMENT_TTL_MS=300000
EXPIRE_POLL_MS=5000
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_MS=30000
API_PORT=3847
API_HOST=0.0.0.0
DB_PATH=/data/nxpayment.sqlite
CORS_ORIGIN=*
NEXT_PUBLIC_API_URL=http://127.0.0.1:3847
WEB_PORT=4321
EMAIL_POLL_MS=30000
# Optional env fallback for Gmail OAuth app. Prefer Merchant Auto-confirm UI → SQLite (encrypted).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# AES-256-GCM key for merchant secrets at rest (falls back to ADMIN_TOKEN if unset).
SECRETS_KEY=
# Google Cloud Console → Authorized redirect URI (API). Default matches local API_PORT.
GMAIL_REDIRECT_URI=http://127.0.0.1:3847/api/oauth/google/callback
# Authorized JavaScript origins (web UI): http://127.0.0.1:4321 and http://localhost:4321

YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_IMAP_HOST=
# WhatsApp OTP (Meta Cloud API). Leave blank → dry-run stub (code returned in API response).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=nxpayment_otp
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_OTP_TTL_MS=600000
