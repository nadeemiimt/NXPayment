{
  "name": "@nxpayment/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integration": "node ./scripts/require-node20.mjs && node --import tsx --test test/integration/payments.integration.test.ts",
    "test:gmail-oauth": "node ./scripts/require-node20.mjs && node --import tsx --test test/integration/gmail-oauth-secrets.integration.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/sensible": "^6.0.3",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "nanoid": "^5.1.5",
    "pino": "^9.6.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
